# Multi-stage build: React production build served by Nginx
# Used by the Kubernetes manifests in k8s/

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json .
RUN npm install --frozen-lockfile

COPY . .

# REACT_APP_API_URL is intentionally left unset so the app uses the
# relative /api base URL (proxied by nginx in the pod).
RUN npm run build

# ── Stage 2: serve ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Remove default nginx config — the k8s ConfigMap mounts the real one
RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
